<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>crab gallery</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="page-header">
    <h1>Crabs'R'Us</h1>
    <span class="count">{{ count }} image{%- if count != 1 -%}s{%- endif -%}</span>
  </header>

  <div class="gallery-container">
    {% if count == 0 %}
    <p class="empty">No images yet. Drop files into <code>./images</code> or upload them to <code>/upload</code>.</p>
    {% else %}
    <main class="thumb-grid">
      {% for i in latest %}
      <a class="grid-item" href="/view/{{ i.title }}" title="{{ i.title }}">
        <div class="grid-thumb">
          <img loading="lazy" width="{{ i.width }}" height="{{ i.height }}"
               src="/images/{{ i.title }}?w=320" alt="{{ i.title }}" />
        </div>
        {% if i.modified_at %}
        <div class="label">{{ i.modified_at | date_format(format="%Y-%m-%d") }}</div>
        {% endif %}
      </a>
      {% endfor %}
    </main>
    {% endif %}
  </div>
</body>
</html>
